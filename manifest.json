{
  "manifest_version": 3,
  "name": "Chat Saver for ChatGPT",
  "version": "0.1.0",
  "description": "Save a ChatGPT chat with all its files, an AI summary, and a brief to continue it in a new chat.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["vendor/jszip.min.js", "src/convert.js", "src/exporter.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html",
  "action": { "default_title": "Chat Saver", "default_popup": "src/popup.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
