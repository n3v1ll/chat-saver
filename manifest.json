{
  "manifest_version": 3,
  "name": "Chat Saver: back up ChatGPT and Claude chats",
  "version": "0.4.0",
  "description": "Automatic backup of your ChatGPT and Claude chats with all their files, a searchable library, AI summaries and continue briefs.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "downloads.ui", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://claude.ai/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["vendor/jszip.min.js", "src/convert.js", "src/exporter.js", "src/runtime.js", "src/providers/chatgpt.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["vendor/jszip.min.js", "src/convert.js", "src/exporter.js", "src/runtime.js", "src/providers/claude-convert.js", "src/providers/claude.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html",
  "action": { "default_title": "Chat Saver", "default_popup": "src/popup.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
